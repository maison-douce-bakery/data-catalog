{
  "name": "bakery-postgres",
  "plugin_id": "postgresql",
  "cron_expression": "0 2 * * 0",
  "enabled": true,
  "queryable": true,
  "config": {
    "host": "__SOURCE_HOST__",
    "port": "__SOURCE_PORT__",
    "query_database": "__SOURCE_DATABASE__",
    "user": "__READER_USER__",
    "password": "__READER_PASSWORD__",
    "ssl_mode": "__SSL_MODE__",
    "include_columns": true,
    "include_databases": true,
    "discover_foreign_keys": true,
    "enable_metrics": true,
    "exclude_system_schemas": true,
    "filter": {
      "include": [
        "^(branches|product_categories|units_of_measure|suppliers|customers|employees|allergens|stock_items|products|supplier_products|product_allergens|recipes|recipe_items|purchase_orders|purchase_order_items|goods_receipts|inventory_lots|goods_receipt_items|stock_movements|production_batches|production_consumptions|promotions|promotion_products|sales|sale_items|sale_promotions|payments|loyalty_transactions|returns|return_items|waste_records|shifts|cash_movements|weather_daily)$",
        "^(stg|int|dim|fct|rpt|snap|bridge)_",
        "^(branch_locations|vietnam_holidays|open_meteo_hourly_weather)$"
      ],
      "exclude": [
        "^simulation_runs$"
      ]
    },
    "tags": [
      "postgres",
      "weekly",
      "sunday"
    ]
  }
}
